[gd_scene load_steps=5 format=3]

[ext_resource type="Script" path="res://scripts/ui/mode_select.gd" id="1_script"]
[ext_resource type="Theme" path="res://assets/Themes/WordWoven_Button_Theme.tres" id="2_theme"]
[ext_resource type="FontFile" path="res://assets/Fonts/BLKCHCRY.TTF" id="3_title"]
[ext_resource type="FontFile" path="res://assets/Fonts/Junicode.ttf" id="4_body"]

[node name="ModeSelect" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_script")

[node name="Background" type="ColorRect" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
color = Color(0.025, 0.035, 0.06, 1)

[node name="Center" type="CenterContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2

[node name="Content" type="VBoxContainer" parent="Center"]
layout_mode = 2
custom_minimum_size = Vector2(900, 0)
theme_override_constants/separation = 22

[node name="Title" type="Label" parent="Center/Content"]
layout_mode = 2
theme_override_colors/font_color = Color(1, 0.82, 0.5, 1)
theme_override_fonts/font = ExtResource("3_title")
theme_override_font_sizes/font_size = 60
text = "Choose Your Tale"
horizontal_alignment = 1

[node name="Subtitle" type="Label" parent="Center/Content"]
layout_mode = 2
theme_override_colors/font_color = Color(0.9, 0.84, 0.72, 1)
theme_override_fonts/font = ExtResource("4_body")
theme_override_font_sizes/font_size = 22
text = "An authored expedition, or a faster run with no finish line."
horizontal_alignment = 1

[node name="Modes" type="HBoxContainer" parent="Center/Content"]
layout_mode = 2
theme_override_constants/separation = 28

[node name="StoryButton" type="Button" parent="Center/Content/Modes"]
unique_name_in_owner = true
custom_minimum_size = Vector2(436, 270)
layout_mode = 2
size_flags_horizontal = 3
theme = ExtResource("2_theme")
theme_type_variation = &"WordWovenActionButton"
theme_override_fonts/font = ExtResource("4_body")
theme_override_font_sizes/font_size = 25
text = "STORY MODE\n\nChoose a biome, chart routes,\nand uncover side events.\n\nA six-encounter tale with a final boss."

[node name="EndlessButton" type="Button" parent="Center/Content/Modes"]
unique_name_in_owner = true
custom_minimum_size = Vector2(436, 270)
layout_mode = 2
size_flags_horizontal = 3
theme = ExtResource("2_theme")
theme_type_variation = &"WordWovenActionButton"
theme_override_fonts/font = ExtResource("4_body")
theme_override_font_sizes/font_size = 25
text = "ENDLESS MODE\n\nFight continuously through\nrandomized arenas and foes.\n\nPowers scale faster. Tavern every 5 waves."

[node name="BackButton" type="Button" parent="Center/Content"]
unique_name_in_owner = true
custom_minimum_size = Vector2(190, 44)
layout_mode = 2
size_flags_horizontal = 4
theme = ExtResource("2_theme")
theme_type_variation = &"WordWovenActionButton"
theme_override_fonts/font = ExtResource("4_body")
theme_override_font_sizes/font_size = 20
text = "Back"
