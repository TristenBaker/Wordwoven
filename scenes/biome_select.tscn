[sub_resource type="Shader" id="Shader_locked"]
code = "shader_type canvas_item;
void fragment() {
    vec4 pixel = texture(TEXTURE, UV);
    float grey = dot(pixel.rgb, vec3(0.299, 0.587, 0.114));
    COLOR = vec4(vec3(grey) * 0.5, pixel.a);
}"

