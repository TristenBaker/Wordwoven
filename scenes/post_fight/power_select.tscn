[gd_scene load_steps=9 format=3]

[ext_resource type="Script" path="res://scripts/post_fight/power_select.gd" id="1_script"]
[ext_resource type="Script" path="res://scripts/post_fight/power_choice_card.gd" id="card_script"]
[ext_resource type="StyleBox" path="res://assets/Themes/encounters/information_panel.tres" id="panel_style"]
[ext_resource type="Texture2D" path="res://art/backgrounds/Victory.png" id="2_background"]
[ext_resource type="FontFile" path="res://assets/Fonts/BLKCHCRY.TTF" id="3_title"]
[ext_resource type="FontFile" path="res://assets/Fonts/Junicode.ttf" id="4_body"]
[ext_resource type="PackedScene" path="res://scenes/ui/equipment_overlay.tscn" id="5_equipment"]

[ext_resource type="Theme" path="res://assets/Themes/WordWoven_Button_Theme.tres" id="ww_buttons"]

[node name="PowerSelect" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_script")

[node name="Background" type="TextureRect" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
texture = ExtResource("2_background")
expand_mode = 1
stretch_mode = 6
mouse_filter = 2

[node name="Shade" type="ColorRect" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
color = Color(0.025, 0.04, 0.065, 0.48)
mouse_filter = 2

[node name="CenterBox" type="CenterContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2

[node name="PowerPanel" type="PanelContainer" parent="CenterBox"]
custom_minimum_size = Vector2(1120, 0)
layout_mode = 2
theme_override_styles/panel = ExtResource("panel_style")

[node name="Content" type="VBoxContainer" parent="CenterBox/PowerPanel"]
layout_mode = 2
theme_override_constants/separation = 10
alignment = 1

[node name="Title" type="Label" parent="CenterBox/PowerPanel/Content"]
layout_mode = 2
theme_override_colors/font_color = Color(0.96, 0.84, 0.6, 1)
theme_override_fonts/font = ExtResource("3_title")
theme_override_font_sizes/font_size = 44
text = "Choose a Power"
horizontal_alignment = 1

[node name="Subtitle" type="Label" parent="CenterBox/PowerPanel/Content"]
layout_mode = 2
theme_override_colors/font_color = Color(0.84, 0.79, 0.69, 1)
theme_override_fonts/font = ExtResource("4_body")
theme_override_font_sizes/font_size = 20
text = "Your victories become part of the tale."
horizontal_alignment = 1

[node name="Choices" type="HBoxContainer" parent="CenterBox/PowerPanel/Content"]
custom_minimum_size = Vector2(0, 428)
layout_mode = 2
theme_override_constants/separation = 20

[node name="ChoiceOne" type="Button" parent="CenterBox/PowerPanel/Content/Choices"]
script = ExtResource("card_script")
