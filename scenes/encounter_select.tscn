[node name="Background" type="ColorRect" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
color = Color(0.09, 0.08, 0.11, 1)

[node name="EnemyFactory" type="Node" parent="."]
script = ExtResource("2_factory")

[node name="CenterBox" type="CenterContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0

[node name="Menu" type="VBoxContainer" parent="CenterBox"]
custom_minimum_size = Vector2(900, 0)
layout_mode = 2
theme_override_constants/separation = 18
alignment = 1

[node name="TitleLabel" type="Label" parent="CenterBox/Menu"]
layout_mode = 2
theme_override_colors/font_color = Color(0.9, 0.78, 0.57, 1)
theme_override_fonts/font = ExtResource("3_title")
theme_override_font_sizes/font_size = 48
text = "Choose your next foe"
horizontal_alignment = 1

[node name="ChoicesBox" type="HBoxContainer" parent="CenterBox/Menu"]
layout_mode = 2
theme_override_constants/separation = 24
alignment = 1

[node name="SelectionLabel" type="Label" parent="CenterBox/Menu"]
custom_minimum_size = Vector2(0, 72)
layout_mode = 2
theme_override_font_sizes/font_size = 17
text = "Pick a foe to see its nature and the ground you will fight on."
horizontal_alignment = 1
autowrap_mode = 2

[node name="TagPrompt" type="Label" parent="CenterBox/Menu"]
layout_mode = 2
theme_override_colors/font_color = Color(1, 0.85, 0.4, 1)
theme_override_font_sizes/font_size = 20
text = "Describe it with any adjective. That word becomes its only counterable tag, and its opposites hit hardest."
horizontal_alignment = 1
autowrap_mode = 2

[node name="TagRow" type="HBoxContainer" parent="CenterBox/Menu"]
layout_mode = 2
theme_override_constants/separation = 12
alignment = 1

[node name="TagInput" type="LineEdit" parent="CenterBox/Menu/TagRow"]
custom_minimum_size = Vector2(320, 44)
layout_mode = 2
theme_override_font_sizes/font_size = 22
placeholder_text = "any adjective, e.g. gloomy"
max_length = 24

[node name="EnterButton" type="Button" parent="CenterBox/Menu/TagRow"]
custom_minimum_size = Vector2(200, 44)
layout_mode = 2
theme_override_font_sizes/font_size = 20
disabled = true
text = "Enter Encounter"

[node name="FeedbackLabel" type="Label" parent="CenterBox/Menu"]
layout_mode = 2
theme_override_colors/font_color = Color(1, 0.45, 0.35, 1)
theme_override_font_sizes/font_size = 17
horizontal_alignment = 1

[node name="ActionConfirmer" type="ConfirmationDialog" parent="."]
title = "Enter encounter"
ok_button_text = "Fight"
script = ExtResource("4_confirmer")
